      "writtenOn": "2025-02-24T14:37:11Z",
      "side": 1,
      "message": "This may be trivial but why this approach as opposed to a TryFrom which can return an Error?",
      "revId": "df8876d1f0a73154dd60fd3e0406fa4b7a7de578",
      "serverId": "8f6f209b-db1a-4cbf-aa44-c8bc30e9bfda"
