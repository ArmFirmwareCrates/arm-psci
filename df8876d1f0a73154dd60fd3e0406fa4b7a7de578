    {
      "unresolved": true,
      "key": {
        "uuid": "30202a0a_c740675d",
        "filename": "src/lib.rs",
        "patchSetId": 4
      },
      "lineNbr": 222,
      "author": {
        "id": 1000159
      },
      "writtenOn": "2025-02-24T15:40:37Z",
      "side": 1,
      "message": "This assert catches a programmer error, when the caller code used an invalid state ID. This should not happen normally, since the state IDs are predefined const values for a platform. If we would use TryFrom, the caller would likely use unwrap() for handling this and then it has the same effect as assert.\n\nSo far, here and in other similar crates like arm-ffa, we used TryFrom for cases when parsing structures from untrusted data and From + assert when its a programmer error.",
      "parentUuid": "c86b85cc_afd897c1",
      "revId": "df8876d1f0a73154dd60fd3e0406fa4b7a7de578",
      "serverId": "8f6f209b-db1a-4cbf-aa44-c8bc30e9bfda"
